# Copy file ini menjadi .env lalu isi nilainya.
# QRIS_IMAGE_URL bisa berupa:
# 1) direct image link https, misalnya https://.../qris.png (content-type image/*)
# 2) link Google Drive (file/d/... atau open?id=...), asalkan file sudah
#    dibagikan ke service account bot sebagai Viewer
# 3) path file lokal, misalnya ./assets/qris.png
QRIS_IMAGE_URL=

# SHA-256 dari file gambar QRIS (WAJIB diisi agar gambar tidak bisa diganti).
# Bot akan menolak mengirim QRIS jika hash tidak cocok.
# Windows : Get-FileHash -Algorithm SHA256 .\assets\qris.png
# Linux   : sha256sum assets/qris.png
QRIS_IMAGE_SHA256=
